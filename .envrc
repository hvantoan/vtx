# ==============================================================================
# VTX per-worktree environment (direnv)
# Auto-loads/unloads when entering/leaving the directory. First time per
# worktree: `direnv allow`.
#
# Isolation model: a stable hash of the worktree dir name picks a dedicated
# 60-port block inside 49000-50799; every published port derives from the
# same BASE so values can never collide across worktrees. COMPOSE_PROJECT_NAME
# keeps docker-compose project + container/volume names apart, and
# TEMPORAL_TASK_QUEUE keeps workers from draining another worktree's tasks.
WORKTREE_NAME="$(basename "$PWD" | tr -cd '[:alnum:]' | tr '[:upper:]' '[:lower:]')"

export WORKTREE_NAME

# Operator-overridable seed vars first: real secrets/overrides live in
# gitignored files, loaded before the computed block below.
dotenv_if_exists .env
dotenv_if_exists .env.local

BASE=$((49000 + ($(echo -n "$WORKTREE_NAME" | cksum | cut -d' ' -f1) % 30) * 60))

# Port block roles (order mirrors .env.example; BASE+0 is the web slot, etc.)
export VTX_WEB_PORT=$((BASE + 0))
export VTX_API_PORT=$((BASE + 1))
export VTX_TEMPORAL_PORT=$((BASE + 2))
export VTX_TEMPORAL_UI_PORT=$((BASE + 3))
export VTX_POSTGRES_PORT=$((BASE + 4))
export VTX_GATEWAY_PORT=$((BASE + 5))

# Compose disambiguation: project name + container names come from the
# worktree, not the hardcoded `name: vtx` / `container_name: vtx-*`.
export COMPOSE_PROJECT_NAME="vtx-${WORKTREE_NAME}"

# Host-side consumers of the shifted ports. Values intentionally override any
# stale copies in .env so a cloned .env from the primary checkout cannot
# resurrect the shared 49xxx endpoints.
export PORT="$VTX_API_PORT"
export DATABASE_URL="postgres://vtx_user:vtx_password@localhost:${VTX_POSTGRES_PORT}/vtx_platform?sslmode=disable"
export TEMPORAL_HOST_PORT="localhost:${VTX_TEMPORAL_PORT}"
export TEMPORAL_TASK_QUEUE="vtx-task-queue-${WORKTREE_NAME}"
export NEXT_PUBLIC_API_URL="http://localhost:${VTX_API_PORT}"
