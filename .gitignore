# ==============================================================================
# VTX Monorepo .gitignore
# ==============================================================================

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Environment & Local secrets
.env
.env.local
.env.*.local
*.pem
*.key
infra/compose/nginx/certs/
infra/compose/config/jira.local.yaml

# Go artifacts
# STRICT CONSTRAINT: NEVER allow go.work or go.work.sum in repository
go.work
go.work.sum
bin/
dist/
*.exe
*.test
*.prof
coverage.out
coverage.html

# Node / JS artifacts
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build output
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Temporal & Local Storage
infra/storage/data/
.temporal/

# Agent-master runtime state (Jira poll cursor + queue)
/var/

# Test & coverage artifacts
test-results/
playwright-report/
blob-report/
# Pi runtime state stays local, but the VTX orchestrator's specialist agents and
# workflow prompts are repo-controlled and reviewed (VTX-ORCH design §7).
.pi/*
!.pi/agents/
!.pi/prompts/
__pycache__/
*.pyc
