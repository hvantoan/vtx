# ==============================================================================
# VTX Platform Environment Configuration
# ==============================================================================

# Server Configuration
PORT=8080
API_HOST=0.0.0.0
APP_ENV=development
API_AUTH_TOKEN=vtx-dev-secret-token-change-in-production

# PostgreSQL 17 (Platform Database)
DATABASE_URL=postgres://vtx_user:vtx_password@localhost:5432/vtx_platform?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=15m

# Temporal Server
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=vtx-task-queue

# Agent Runtime Configuration
AGENT_RUNTIME_DIR=./apps/agent-runtime
AGENT_DEFAULT_TYPE=pi
AGENT_TASK_TIMEOUT_MS=60000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=development
