# ==============================================================================
# VTX Platform Environment Configuration
# ==============================================================================

# ==============================================================================
# VTX Port Cluster (host-side, dev + docker-compose)
# Dedicated 49xxx block — avoids common defaults (3000/5432/7233/8080/8233)
# so the platform never collides with other local dev stacks.
# VTX_API_PORT          49080  Go backend API
# VTX_WEB_PORT          49030  Next.js cockpit
# VTX_TEMPORAL_PORT     49233  Temporal gRPC frontend
# VTX_TEMPORAL_UI_PORT  49234  Temporal Web UI
# VTX_POSTGRES_PORT     49432  PostgreSQL
# ==============================================================================
VTX_WEB_PORT=49030
VTX_API_PORT=49080
VTX_TEMPORAL_PORT=49233
VTX_TEMPORAL_UI_PORT=49234
VTX_POSTGRES_PORT=49432


# Server Configuration
# Every secret slot below marked [SETUP-GEN] is filled with a random value by
# infra/scripts/setup-vtx-host.sh when left empty or at its placeholder.
PORT=49080
API_HOST=0.0.0.0
APP_ENV=development
# Operator login sessions (username/password seeded via `make user-password`).
# Sliding lifetime; the session is extended at most once per hour.
SESSION_TTL=720h
# Secure cookie mode: auto (Secure when the request arrived over HTTPS),
# always, or never (plain-HTTP LAN only). Use auto for tunnel + LAN.
SESSION_COOKIE_SECURE=auto

# PostgreSQL 17 (Platform Database)
DATABASE_URL=postgres://vtx_user:vtx_password@localhost:49432/vtx_platform?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=15m

# Temporal Server
TEMPORAL_HOST_PORT=localhost:49233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=vtx-task-queue

# Agent Runtime Configuration
AGENT_RUNTIME_DIR=./apps/agent-runtime
AGENT_DEFAULT_TYPE=pi
AGENT_TASK_TIMEOUT_MS=60000

# Next.js Frontend Configuration
# Server-side proxy target for /api/*; compose overrides this to the service
# name (http://backend:49080). The browser always uses the same origin.
INTERNAL_API_URL=http://localhost:49080

# ==============================================================================
# Jira Webhook Intake (VTX-2, SPEC-AUTO-01)
# ==============================================================================
# Verify the target status ID against the live tenant before configuring:
#   curl -u "$JIRA_API_EMAIL:$JIRA_API_TOKEN" \
#     "$JIRA_BASE_URL/rest/api/3/project/<PROJECT>/statuses"
# (Transition id=2 in the Jira UI is the transition ID, NOT the status ID.)
JIRA_BASE_URL=https://vtxsolution.atlassian.net
# [SETUP-GEN] placeholders are inserted when empty so the api passes
# fail-closed validation — replace with real tenant creds for live intake.
JIRA_API_EMAIL=you@example.com
JIRA_API_TOKEN=
# Project→start-status policy lives in infra/compose/config/jira.yaml,
# mounted by compose as JIRA_CONFIG_PATH=/etc/vtx/jira.yaml. To manage it via
# env instead (legacy path), unset JIRA_CONFIG_PATH and set BOTH
# JIRA_PROJECT_ALLOWLIST and JIRA_READY_TO_DEV_STATUS_ID — never both sources.
JIRA_SITE_ID=vtxsolution.atlassian.net

# Internal Bearer token the Nginx gateway injects on the rewritten request.
# MUST differ from every REGISTRY_ACTOR_* token — the backend asserts this at
# startup.
# [SETUP-GEN]
GATEWAY_INTERNAL_AUTH_TOKEN=

# Webhook URL path secrets. Both may be set during rotation overlap.
# [SETUP-GEN]
WEBHOOK_PATH_SECRET_PRIMARY=
WEBHOOK_PATH_SECRET_SECONDARY=

# Nginx webhook gateway port (HTTPS)
VTX_GATEWAY_PORT=49443

# VTX-3 machine actor tokens. One token per principal — the actor of a request
# is derived from the token, never from the body. All three are required by
# cmd/api (ValidateRegistry fails closed) and must differ from each other and
# from GATEWAY_INTERNAL_AUTH_TOKEN. Human operators authenticate with a
# username/password session instead; there is no operator bearer token.
# [SETUP-GEN] x3 — all three generated, all distinct
REGISTRY_ACTOR_SCHEDULER_TOKEN=
REGISTRY_ACTOR_ORCHESTRATOR_TOKEN=
REGISTRY_ACTOR_POLICY_TOKEN=

# Delivery identity of the registry outbox dispatcher (all replicas share it).
REGISTRY_CONSUMER_NAME=registry-intake
